# Canonical origin for this deployment. No trailing slash.
#
# Leave unset in production: the code defaults to the production domain
# (https://rfpsoftwareguide.com). Set it on preview/staging deployments so their
# canonical URLs, sitemap, robots.txt, RSS feed and Open Graph tags point at
# themselves instead of claiming the production origin.
#
# Read at build time — a rebuild is required for a change to take effect.
NEXT_PUBLIC_SITE_URL=https://rfpsoftwareguide.com
